PORT=4300
PERSISTENCE=memory
NODE_ENV=development   # Do NOT set NODE_ENV in Vercel.
# Lock CORS to your domain(s) in production (comma-separated). If unset while
# NODE_ENV=production, the app defaults to https://ys-connection.vercel.app
# (never a wildcard). For local dev it defaults to '*'.
# CORS_ORIGINS=https://ys-connection.vercel.app
# For Supabase:
# PERSISTENCE=supabase
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres   # Session pooler, port 5432
# SESSION_SECRET=<random-32+-char-string>   # REQUIRED in production — signs session tokens
# SETUP_CODE=<16+ characters — first-run admin creation>
# FIELD_ENCRYPTION_KEY=<base64 of 32 random bytes>
# GOOGLE_SA_JSON=<the service-account key file, one line>
# GOOGLE_MAPS_API_KEY=<API key>
